# ==============================================================================
# CrashKiller Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# --- Application & Web Server ---
APP_NAME=CrashKiller
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=[]
HTTP_BIND_HOST=127.0.0.1
HTTP_PORT=8080
# Set both credentials to enable the browser UI and management API.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ALLOW_UNAUTHENTICATED_SYMSRV=false

# --- PostgreSQL (postgres:16-alpine with pg_trgm) ---
POSTGRES_USER=crashkiller
POSTGRES_PASSWORD=crashkiller
POSTGRES_DB=crashkiller
DATABASE_URL=postgresql+asyncpg://crashkiller:crashkiller@postgres:5432/crashkiller

# --- Redis (redis:7-alpine) ---
REDIS_URL=redis://redis:6379/0

# --- Host Storage & Partition Layout ---
# Host directory mounted into /data in api and worker containers
CRASHKILLER_DATA_PATH=./data
DATA_DIR=/data

# --- Compact Disk Quotas & Safety Floor (GB / Days) ---
# Upload admission budget for artifacts and measured PostgreSQL data (GiB)
TOTAL_DISK_QUOTA_GB=150.0
# Host free-space safety floor: trigger emergency GC & stop raw archiving below 50GB
HOST_SAFETY_FLOOR_GB=50.0

# Per-partition budgets (GiB)
DB_QUOTA_GB=15.0
SYMBOLS_SYM_QUOTA_GB=15.0
SYMBOLS_PUBLIC_CACHE_QUOTA_GB=5.0
SYMBOLS_RAW_QUOTA_GB=15.0
LOGS_QUOTA_GB=55.0
DUMPS_QUOTA_GB=35.0
STAGING_QUOTA_GB=10.0

# GC & retention policy
GC_THRESHOLD_PERCENT=85.0
LOG_RETENTION_DAYS=30
DUMP_RETENTION_DAYS=14
STAGING_TTL_HOURS=6
ARCHIVE_RAW_SYMBOLS=false

# --- Native Symbol & MiniDump Toolchain ---
DUMP_SYMS_BIN=dump_syms
MINIDUMP_STACKWALK_BIN=minidump-stackwalk
ENABLE_PUBLIC_SYMBOLS=true
PUBLIC_SYMBOL_URLS=["https://symbols.mozilla.org/","https://msdl.microsoft.com/download/symbols/"]
TOOL_TIMEOUT_SECONDS=120

# --- Chunked Zstd Compression ---
LOG_CHUNK_SIZE_BYTES=262144
LOG_ZSTD_LEVEL=6
DUMP_ZSTD_LEVEL=3

# --- AI Agent & OpenAI-Compatible LLM Configuration ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# SMART_TRIAGE | ALWAYS | MANUAL
AI_TRIAGE_MODE=SMART_TRIAGE
AI_MAX_STEPS=10
AI_TIMEOUT_SECONDS=120
AI_TOOL_OUTPUT_MAX_CHARS=8000
